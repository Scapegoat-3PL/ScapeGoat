{
  "name": "scapegoatquoteeditor",
  "compatibility_date": "2026-11-18",
  "main": "./quote-editor/worker/site-router.mjs",
  "vars": {
    "EDITOR_ORIGIN": "https://scapegoatquoteeditor.sean-0a8.workers.dev",
    "ENABLE_FINALIZATION": "false"
  },
  "assets": {
    "directory": "./quote-editor/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  }
}
